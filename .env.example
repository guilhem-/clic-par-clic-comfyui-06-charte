# Open WebUI: address and token of an administrator account (Settings > Account > API keys, or a session token).
OWUI_URL=http://127.0.0.1:8080
OWUI_TOKEN=
# The "Image workshop" tool of modules 4 and 5 (English id; the French one is atelier_images).
TOOL_ID=image_workshop
# Model of the instance that classifies descriptions (must be readable by the users and by the robot).
CHARTER_MODEL=gpt-5.6-luna
# Robot account used by the gateway (role "user"). Leave the password empty to have one generated.
ROBOT_EMAIL=image-policy@example.com
ROBOT_PASSWORD=
# en (default) or de: German filter, tool version 2 and policy (open-webui/*.de.py, charter.de.md).
LANGUAGE=en
